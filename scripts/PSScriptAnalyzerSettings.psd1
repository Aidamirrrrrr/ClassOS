@{
    # Правила, снятые осознанно. Список короткий намеренно: каждое снятое
    # правило — это класс дефектов, который перестаёт ловиться, поэтому здесь
    # только то, что не применимо к операторским скриптам, а не то, что было
    # неудобно чинить.
    ExcludeRules = @(
        # Скрипты этого каталога — консольные инструменты для человека:
        # установщик, статус, прогон приёмки. Их вывод предназначен глазам
        # оператора и намеренно не должен попадать в конвейер или
        # захватываться как результат функции. Write-Output здесь означал бы,
        # что текст для человека смешивается с возвращаемым значением.
        'PSAvoidUsingWriteHost',

        # Правило требует ShouldProcess (-WhatIf/-Confirm) у функций с
        # глаголами-изменениями. Это осмысленно для модулей, откуда функции
        # вызывают другие; здесь функции внутренние, а подтверждение
        # необратимых действий уже решается на уровне самого скрипта.
        'PSUseShouldProcessForStateChangingFunctions',

        # Множественное число во внутренних функциях-помощниках
        # (Get-SessionHostProcesses возвращает именно список).
        'PSUseSingularNouns',

        # Ложное срабатывание: параметры уровня скрипта используются внутри
        # функций, а анализатор считает области видимости раздельно.
        'PSReviewUnusedParameter'
    )
}
